generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum Winner {
  VILLAGERS
  WEREWOLVES
}

enum Role {
  WEREWOLF
  VILLAGER
  SEER
  WITCH
}

enum Phase {
  DAY
  NIGHT
}

enum GameMode {
  CLASSIC
  ARENA
}

enum ActionType {
  KILL
  INVESTIGATE
  HEAL
  WITCH_KILL
}

enum TrustDimension {
  ALIGNMENT
  INFORMATION
  CONSISTENCY
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

enum LabelCheckpoint {
  BEFORE_DISCUSSION
  BEFORE_VOTING
  AFTER_VOTING
}

model Game {
  id           String     @id @default(uuid())
  roomCode     String     @unique @map("room_code")
  gameMode     GameMode   @default(CLASSIC) @map("game_mode")
  status       GameStatus @default(WAITING)
  winner       Winner?
  playerCount  Int        @default(0) @map("player_count")
  totalRounds  Int        @default(0) @map("total_rounds")
  startedAt    DateTime?  @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  players      Player[]
  messages     Message[]
  nightActions NightAction[]
  playerNotes  PlayerNote[]
  labels       Label[]

  @@map("games")
}

model Player {
  id               String   @id @default(uuid())
  gameId           String   @map("game_id")
  name             String
  role             Role
  isWinner         Boolean? @map("is_winner")
  eliminationRound Int?     @map("elimination_round")
  eliminationPhase Phase?   @map("elimination_phase")

  game             Game               @relation(fields: [gameId], references: [id])
  messages         Message[]
  actionsPerformed NightAction[]      @relation("Performer")
  actionsReceived  NightAction[]      @relation("Target")
  notes            PlayerNote[]
  labelsAuthored   Label[]            @relation("LabelObserver")
  labelsAsTarget   LabelTarget[]      @relation("LabelTargetPlayer")

  @@map("players")
}

model Message {
  id         String   @id @default(uuid())
  gameId     String   @map("game_id")
  playerId   String?  @map("player_id")
  playerName String   @map("player_name")
  role       Role?
  content    String
  phase      Phase
  round      Int
  isSystem   Boolean  @default(false) @map("is_system")
  createdAt  DateTime @default(now()) @map("created_at")

  game   Game    @relation(fields: [gameId], references: [id])
  player Player? @relation(fields: [playerId], references: [id])

  @@map("messages")
}

model PlayerNote {
  id         String   @id @default(uuid())
  gameId     String   @map("game_id")
  playerId   String   @map("player_id")
  playerName String   @map("player_name")
  content    String
  phase      Phase
  round      Int
  createdAt  DateTime @default(now()) @map("created_at")

  game   Game   @relation(fields: [gameId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@map("player_notes")
}

model NightAction {
  id             String     @id @default(uuid())
  gameId         String     @map("game_id")
  playerId       String     @map("player_id")
  actionType     ActionType @map("action_type")
  targetPlayerId String     @map("target_player_id")
  round          Int
  wasBlocked     Boolean    @default(false) @map("was_blocked")

  game         Game   @relation(fields: [gameId], references: [id])
  player       Player @relation("Performer", fields: [playerId], references: [id])
  targetPlayer Player @relation("Target", fields: [targetPlayerId], references: [id])

  @@map("night_actions")
}

model Label {
  id         String          @id @default(uuid())
  gameId     String          @map("game_id")
  observerId String          @map("observer_id")
  checkpoint LabelCheckpoint
  round      Int
  createdAt  DateTime        @default(now()) @map("created_at")

  game     Game          @relation(fields: [gameId], references: [id])
  observer Player        @relation("LabelObserver", fields: [observerId], references: [id])
  targets  LabelTarget[]

  @@map("labels")
}

model LabelTarget {
  id        String @id @default(uuid())
  labelId   String @map("label_id")
  targetId  String @map("target_id")
  reasoning String

  label   Label              @relation(fields: [labelId], references: [id], onDelete: Cascade)
  target  Player             @relation("LabelTargetPlayer", fields: [targetId], references: [id])
  updates LabelTrustUpdate[]

  @@unique([labelId, targetId])
  @@map("label_targets")
}

model LabelTrustUpdate {
  id            String         @id @default(uuid())
  labelTargetId String         @map("label_target_id")
  dimension     TrustDimension
  score         Int
  confidence    Confidence

  labelTarget LabelTarget @relation(fields: [labelTargetId], references: [id], onDelete: Cascade)

  @@unique([labelTargetId, dimension])
  @@map("label_trust_updates")
}
