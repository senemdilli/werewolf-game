generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum Winner {
  VILLAGERS
  WEREWOLVES
}

enum Role {
  WEREWOLF
  VILLAGER
  SEER
  WITCH
}

enum Phase {
  DAY
  NIGHT
}

enum GameMode {
  CLASSIC
  ARENA
}

enum ActionType {
  KILL
  INVESTIGATE
  HEAL
  WITCH_KILL
}

enum TrustDimension {
  ALIGNMENT
  INFORMATION
  CONSISTENCY
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

enum LabelAction {
  VOTED_TO_EXILE
  VOTED_FOR_MAYOR
  ACCUSED_OF_WEREWOLF
  ACCUSED_OF_LYING
  CLAIMED_ROLE
  DEFENDED
  SUPPORTED
  BETRAYED
  CONTRADICTED_THEMSELVES
  DID_NOT_RESPOND
  OTHER
}

model Game {
  id           String     @id @default(uuid())
  roomCode     String     @unique @map("room_code")
  gameMode     GameMode   @default(CLASSIC) @map("game_mode")
  status       GameStatus @default(WAITING)
  winner       Winner?
  playerCount  Int        @default(0) @map("player_count")
  totalRounds  Int        @default(0) @map("total_rounds")
  startedAt    DateTime?  @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  players      Player[]
  messages     Message[]
  nightActions NightAction[]
  playerNotes  PlayerNote[]
  labels       Label[]

  @@map("games")
}

model Player {
  id               String   @id @default(uuid())
  gameId           String   @map("game_id")
  name             String
  role             Role
  isWinner         Boolean? @map("is_winner")
  eliminationRound Int?     @map("elimination_round")
  eliminationPhase Phase?   @map("elimination_phase")

  game             Game               @relation(fields: [gameId], references: [id])
  messages         Message[]
  actionsPerformed NightAction[]      @relation("Performer")
  actionsReceived  NightAction[]      @relation("Target")
  notes            PlayerNote[]
  labelsAuthored   Label[]            @relation("LabelObserver")
  labelsAsTarget   LabelTrustUpdate[] @relation("LabelTarget")

  @@map("players")
}

model Message {
  id         String   @id @default(uuid())
  gameId     String   @map("game_id")
  playerId   String?  @map("player_id")
  playerName String   @map("player_name")
  role       Role?
  content    String
  phase      Phase
  round      Int
  isSystem   Boolean  @default(false) @map("is_system")
  createdAt  DateTime @default(now()) @map("created_at")

  game   Game    @relation(fields: [gameId], references: [id])
  player Player? @relation(fields: [playerId], references: [id])
  labels Label[]

  @@map("messages")
}

model PlayerNote {
  id         String   @id @default(uuid())
  gameId     String   @map("game_id")
  playerId   String   @map("player_id")
  playerName String   @map("player_name")
  content    String
  phase      Phase
  round      Int
  createdAt  DateTime @default(now()) @map("created_at")

  game   Game   @relation(fields: [gameId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@map("player_notes")
}

model NightAction {
  id             String     @id @default(uuid())
  gameId         String     @map("game_id")
  playerId       String     @map("player_id")
  actionType     ActionType @map("action_type")
  targetPlayerId String     @map("target_player_id")
  round          Int
  wasBlocked     Boolean    @default(false) @map("was_blocked")

  game         Game   @relation(fields: [gameId], references: [id])
  player       Player @relation("Performer", fields: [playerId], references: [id])
  targetPlayer Player @relation("Target", fields: [targetPlayerId], references: [id])

  @@map("night_actions")
}

model Label {
  id         String      @id @default(uuid())
  gameId     String      @map("game_id")
  observerId String      @map("observer_id")
  eventId    String?     @map("event_id")
  action     LabelAction
  actionArgs String?     @map("action_args")
  reasoning  String
  phase      Phase
  round      Int
  createdAt  DateTime    @default(now()) @map("created_at")

  game         Game               @relation(fields: [gameId], references: [id])
  observer     Player             @relation("LabelObserver", fields: [observerId], references: [id])
  event        Message?           @relation(fields: [eventId], references: [id])
  trustUpdates LabelTrustUpdate[]

  @@map("labels")
}

model LabelTrustUpdate {
  id         String         @id @default(uuid())
  labelId    String         @map("label_id")
  targetId   String         @map("target_id")
  dimension  TrustDimension
  score      Int
  confidence Confidence

  label  Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  target Player @relation("LabelTarget", fields: [targetId], references: [id])

  @@unique([labelId, targetId, dimension])
  @@map("label_trust_updates")
}
