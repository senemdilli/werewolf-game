{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExperimentPlayerLabels",
  "type": "object",
  "required": [
    "game_id",
    "game_file",
    "player_name",
    "trust_scale_mode",
    "models",
    "experiment",
    "formatter",
    "temperature",
    "max_phases",
    "context_as_tool",
    "total_phases",
    "alive_phases",
    "phases"
  ],
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Unique identifier of the game record"
    },
    "game_file": {
      "type": "string",
      "description": "File base name of the game record"
    },
    "player_name": {
      "type": "string",
      "description": "Name of the player being labeled"
    },
    "trust_scale_mode": {
      "type": "string",
      "enum": ["numeric", "likert-agree-disagree", "likert-legacy"],
      "description": "Indicates whether trust and confidence were evaluated using numeric scores or Likert scales"
    },
    "models": {
      "type": "object",
      "required": ["primary_model"],
      "properties": {
        "primary_model": {
          "type": "string"
        },
        "inner_voice_model": {
          "type": "string"
        }
      }
    },
    "prompts": {
      "type": "object",
      "description": "Mapping of prompt IDs to templates used"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "experiment": {
      "type": "string"
    },
    "formatter": {
      "type": "string",
      "enum": ["markdown", "json"]
    },
    "experiment_args": {
      "type": "string"
    },
    "temperature": {
      "type": "number",
      "description": "The generation temperature used for LLM calls"
    },
    "max_phases": {
      "type": "integer",
      "description": "The maximum number of phases limited for this run"
    },
    "context_as_tool": {
      "type": "boolean",
      "description": "Whether context was retrieved via tool call instead of pre-injected in prompt"
    },
    "total_phases": {
      "type": "integer"
    },
    "alive_phases": {
      "type": "integer"
    },
    "elapsed_seconds": {
      "type": "number",
      "description": "The total execution time of the labeling run for this player in seconds"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase_idx",
          "context",
          "inner_voice",
          "labels"
        ],
        "properties": {
          "phase_idx": {
            "type": "integer"
          },
          "context": {
            "type": "string"
          },
          "inner_voice": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "request",
                "response"
              ],
              "properties": {
                "request": {
                  "type": "object"
                },
                "response": {
                  "type": "string"
                }
              }
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "alignment": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "trust": {
                      "type": [
                        "integer",
                        "string",
                        "null"
                      ]
                    },
                    "trust_likert": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "confidence": {
                      "type": [
                        "integer",
                        "string",
                        "null"
                      ]
                    },
                    "confidence_likert": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "information": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "trust": {
                      "type": [
                        "integer",
                        "string",
                        "null"
                      ]
                    },
                    "trust_likert": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "confidence": {
                      "type": [
                        "integer",
                        "string",
                        "null"
                      ]
                    },
                    "confidence_likert": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "consistency": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "trust": {
                      "type": [
                        "integer",
                        "string",
                        "null"
                      ]
                    },
                    "trust_likert": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "confidence": {
                      "type": [
                        "integer",
                        "string",
                        "null"
                      ]
                    },
                    "confidence_likert": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "reasoning": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "reasoning": {
            "type": [
              "string",
              "null"
            ]
          },
          "trace_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["thinking", "tool_call", "tool_result", "user_message"]
                },
                "content": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "tool_name": {
                  "type": "string"
                },
                "tool_args": {
                  "type": "object"
                },
                "tool_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "description": "Chronological list of all trace events (thinking, tool calls, and results) generated during this phase"
          }
        }
      }
    }
  }
}
